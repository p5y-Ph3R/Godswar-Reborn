# Copy this file to .env.secure.local and keep the copy untracked.
#
# The PFX must contain the private server leaf and public development root.
# The password file must contain only the PFX password plus an optional final
# newline. Restrict both host files to the account running Docker Desktop.
GODSWAR_SECURE_CERTIFICATE_HOST_PATH=C:/ProgramData/RebornSecureNetworkRuntime/replace-with-current-runtime/tls/reborn-development-server.pfx
GODSWAR_SECURE_CERTIFICATE_PASSWORD_HOST_PATH=C:/ProgramData/RebornSecureNetworkRuntime/replace-with-current-runtime/tls/docker-certificate-password.txt

# This is the durable database used by the existing PostgreSQL volume. Do not
# point routine development at a disposable godswar_secure_acceptance_* DB.
GODSWAR_SECURE_POSTGRES_DB=godswar

# The container binds only this dedicated private Docker interface. Change both
# values together if the subnet overlaps a VPN or another Docker network.
GODSWAR_SECURE_DOCKER_SUBNET=172.31.250.0/24
GODSWAR_SECURE_CONTAINER_BIND_ADDRESS=172.31.250.10

# This is the approved original-client executable hash, not a password.
GODSWAR_SECURE_ALLOWED_ORIGIN_SHA256=753BE49FE94B6F4C0E3329BC8905945BD9B0F1A790B4B9038E69C2A5AD49ED79
