{
  "runtimeProfile": "LocalDevelopment",
  "game": {
    "worldInstances": {
      "serverNodeId": "worker-a",
      "staticOpenWorldInstances": [
        {
          "realmId": 1,
          "mapId": 1,
          "worldInstanceId": "11111111-1111-1111-1111-111111111111"
        }
      ]
    }
  },
  "dataPath": "data",
  "storage": {
    "provider": "Json"
  },
  "authentication": {
    "allowLegacyRawAuthentication": false
  },
  "secure": {
    "enabled": false
  },
  "backhaul": {
    "enabled": true,
    "bindHost": "127.0.0.1",
    "port": 17000,
    "certificatePath": "artifacts/backhaul-development-tls/backhaul-development-worker-a.pfx",
    "certificatePasswordEnvironmentVariable": "GODSWAR_BACKHAUL_DEVELOPMENT_CERTIFICATE_PASSWORD",
    "allowedGatewayCertificateSha256": [
      "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"
    ],
    "admissionCapacity": 512,
    "replayCapacity": 4096,
    "replayRetentionSeconds": 300,
    "futureClockSkewSeconds": 15,
    "cleanupBatchSize": 64,
    "maximumConcurrentTlsHandshakes": 32,
    "tlsHandshakeTimeoutMilliseconds": 5000,
    "openSessionTimeoutMilliseconds": 2000,
    "writeTimeoutMilliseconds": 5000
  },
  "operations": {
    "management": {
      "enabled": true,
      "bindHost": "127.0.0.1",
      "port": 9090
    }
  }
}
